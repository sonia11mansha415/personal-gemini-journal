# Personal Gemini Journal — local development environment
# Copy to .env for local development only. Never commit .env.

# Required: server-side Gemini API key.
# In Cloud Run, provide this through Secret Manager instead of an env file.
GEMINI_API_KEY="your-gemini-api-key"

# Optional: browser-visible Google Maps key used by Vite.
# Restrict this key by HTTP referrer and to Maps JavaScript API,
# Places API (New), and Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=""

# Local server port. Cloud Run injects PORT automatically.
PORT=3000

# NODE_ENV is intentionally omitted.
# `npm run dev` uses Vite development middleware; compiled Cloud Run builds
# are detected automatically by the server at runtime.
